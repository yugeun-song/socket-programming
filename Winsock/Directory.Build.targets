<Project>
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <UseStandardPreprocessor Condition="'$(PlatformToolset)' != 'ClangCL'">true</UseStandardPreprocessor>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <TreatSpecificWarningsAsErrors>4774;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
      <GuardEHContMetadata Condition="'$(Platform)' == 'x64'">true</GuardEHContMetadata>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LinkIncremental>false</LinkIncremental>
      <LinkGuardEHContMetadata Condition="'$(Platform)' == 'x64'">true</LinkGuardEHContMetadata>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Sanitize'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <InlineFunctionExpansion>Disabled</InlineFunctionExpansion>
      <IntrinsicFunctions>false</IntrinsicFunctions>
      <SupportJustMyCode>false</SupportJustMyCode>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SDLCheck>false</SDLCheck>
      <TreatSpecificWarningsAsErrors>4146;4308;4532;4533;4700;4703;4789;4995;4996;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
      <BufferSecurityCheck>false</BufferSecurityCheck>
    </ClCompile>
    <Link>
      <RandomizedBaseAddress>false</RandomizedBaseAddress>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Sanitize'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <SDLCheck>true</SDLCheck>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <CETCompat Condition="'$(Platform)' == 'x64'">true</CETCompat>
      <AdditionalOptions Condition="'$(Platform)' == 'x64'">/HIGHENTROPYVA %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(PlatformToolset)' == 'ClangCL'">
    <ClCompile>
      <AdditionalOptions>-Wshadow /clang:-pedantic -Werror=format-security /clang:-fno-omit-frame-pointer %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(PlatformToolset)' == 'ClangCL' And ('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Sanitize')">
    <ClCompile>
      <AdditionalOptions>/clang:-ffp-contract=off -fno-eliminate-unused-debug-types /clang:-fkeep-persistent-storage-variables %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>