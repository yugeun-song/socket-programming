root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Windows conventions; the final-newline rule above still applies
[Winsock/**]
end_of_line = crlf
insert_final_newline = false

# Visual Studio project metadata, wherever it sits
[*.{sln,vcxproj,filters,props,targets}]
end_of_line = crlf

# Recipes are hard tabs
[**/Makefile]
indent_style = tab
tab_width = 4

[*.{json,yml,yaml,md}]
indent_size = 2