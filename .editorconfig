root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{c,h}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Visual Studio project metadata, wherever it sits
[*.{sln,slnx,vcxproj,filters,props,targets}]
end_of_line = crlf

# Recipes are hard tabs
[{**/Makefile,**/*.mk}]
indent_style = tab
indent_size = tab
tab_width = 8

[*.{json,yml,yaml,md}]
indent_size = 2